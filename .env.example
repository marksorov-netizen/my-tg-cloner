# ==============================================
# MyBotAi11 — Шаблон конфигурации
# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в git!
# ==============================================

# --------------------------------------------------
# Telegram User API (получить на https://my.telegram.org)
# --------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --------------------------------------------------
# Google Gemini API Key (серверный, ТОЛЬКО для backend)
# Получить: https://aistudio.google.com/app/apikey
# ВНИМАНИЕ: Это серверный ключ — НЕ должен попасть во фронтенд!
# --------------------------------------------------
GEMINI_API_KEY=

# --------------------------------------------------
# Безопасность (ОБЯЗАТЕЛЬНО для продакшена)
# --------------------------------------------------

# Fernet-ключ для шифрования tg_api_hash, session string в БД.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Секрет для подписи JWT-токенов сессий.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --------------------------------------------------
# База данных
# Dev (по умолчанию): SQLite — ничего настраивать не нужно
# Prod: PostgreSQL (docker-compose поднимает сервис db сам)
# --------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://ghostpost:password@db:5432/ghostpost

# Креды для сервиса db в docker-compose (подставляются в DATABASE_URL автоматически)
POSTGRES_USER=ghostpost
POSTGRES_PASSWORD=ПОМЕНЯЙ_МЕНЯ
POSTGRES_DB=ghostpost

# --------------------------------------------------
# Сервер
# --------------------------------------------------
# HOST=127.0.0.1
# PORT=8000

# true на проде за HTTPS — JWT-cookie будет отправляться только по защищённому соединению
COOKIE_SECURE=false

# --------------------------------------------------
# CORS — разрешённые домены для frontend
# Dev: http://localhost:5173
# Prod: https://yourdomain.com
# --------------------------------------------------
# ALLOWED_ORIGINS=http://localhost:5173

